rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'sintaro1945@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'positionId', 'dailyRate', 'phone', 'joinedDate', 'avatarUrl']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 255 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role is string && (data.role == 'admin' || data.role == 'employee') &&
             (!data.keys().hasAll(['positionId']) || (data.positionId is string && data.positionId.size() <= 128)) &&
             (!data.keys().hasAll(['dailyRate']) || data.dailyRate is number) &&
             (!data.keys().hasAll(['phone']) || (data.phone is string && data.phone.size() <= 30)) &&
             (!data.keys().hasAll(['joinedDate']) || (data.joinedDate is string && data.joinedDate.size() <= 50)) &&
             (!data.keys().hasAll(['avatarUrl']) || (data.avatarUrl is string && data.avatarUrl.size() <= 2000));
    }

    function isValidPosition(data) {
      return data.keys().hasAll(['id', 'title', 'department', 'baseDailyRate']) &&
             data.keys().hasOnly(['id', 'title', 'department', 'baseDailyRate']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 100 &&
             data.department is string && data.department.size() <= 100 &&
             data.baseDailyRate is number;
    }

    function isValidWorkSetting(data) {
      return data.keys().hasAll(['id', 'workStart', 'workEnd']) &&
             data.keys().hasOnly(['id', 'workStart', 'workEnd', 'lateToleranceMinutes', 'workDays']) &&
             data.id is string && data.id.size() <= 128 &&
             data.workStart is string && data.workStart.size() <= 10 &&
             data.workEnd is string && data.workEnd.size() <= 10 &&
             (!data.keys().hasAll(['lateToleranceMinutes']) || data.lateToleranceMinutes is number) &&
             (!data.keys().hasAll(['workDays']) || (data.workDays is string && data.workDays.size() <= 100));
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['id', 'userId', 'date', 'status']) &&
             data.keys().hasOnly(['id', 'userId', 'userName', 'date', 'clockInTime', 'clockInSelfieUrl', 'clockInLocation', 'clockOutTime', 'clockOutSelfieUrl', 'clockOutLocation', 'status', 'notes']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.date is string && data.date.size() <= 20 &&
             data.status is string && (data.status == 'Present' || data.status == 'Late' || data.status == 'Absent' || data.status == 'Early Leave') &&
             (!data.keys().hasAll(['userName']) || (data.userName is string && data.userName.size() <= 100)) &&
             (!data.keys().hasAll(['clockInTime']) || (data.clockInTime is string && data.clockInTime.size() <= 30)) &&
             (!data.keys().hasAll(['clockInSelfieUrl']) || (data.clockInSelfieUrl is string && data.clockInSelfieUrl.size() <= 2000)) &&
             (!data.keys().hasAll(['clockInLocation']) || (data.clockInLocation is string && data.clockInLocation.size() <= 200)) &&
             (!data.keys().hasAll(['clockOutTime']) || (data.clockOutTime is string && data.clockOutTime.size() <= 30)) &&
             (!data.keys().hasAll(['clockOutSelfieUrl']) || (data.clockOutSelfieUrl is string && data.clockOutSelfieUrl.size() <= 2000)) &&
             (!data.keys().hasAll(['clockOutLocation']) || (data.clockOutLocation is string && data.clockOutLocation.size() <= 200)) &&
             (!data.keys().hasAll(['notes']) || (data.notes is string && data.notes.size() <= 500));
    }

    function isValidPayroll(data) {
      return data.keys().hasAll(['id', 'userId', 'month', 'totalDaysPresent', 'dailyRate', 'totalAmount', 'status']) &&
             data.keys().hasOnly(['id', 'userId', 'month', 'totalDaysPresent', 'dailyRate', 'totalAmount', 'status', 'generatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.month is string && data.month.size() <= 20 &&
             data.totalDaysPresent is number &&
             data.dailyRate is number &&
             data.totalAmount is number &&
             data.status is string && (data.status == 'Draft' || data.status == 'Paid') &&
             (!data.keys().hasAll(['generatedAt']) || (data.generatedAt is string && data.generatedAt.size() <= 50));
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (incoming().uid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        (existing().uid == request.auth.uid && incoming().uid == existing().uid && incoming().role == existing().role)
      );
      allow delete: if isAdmin();
    }

    match /positions/{positionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(positionId) && isValidPosition(incoming()) && isAdmin();
      allow update: if isSignedIn() && isValidId(positionId) && isValidPosition(incoming()) && isAdmin();
      allow delete: if isAdmin();
    }

    match /work_settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(settingId) && isValidWorkSetting(incoming()) && isAdmin();
      allow update: if isSignedIn() && isValidId(settingId) && isValidWorkSetting(incoming()) && isAdmin();
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(incoming()) && (incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && isValidId(attendanceId) && isValidAttendance(incoming()) && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().userId == existing().userId)
      );
      allow delete: if isAdmin();
    }

    match /payrolls/{payrollId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(payrollId) && isValidPayroll(incoming()) && isAdmin();
      allow update: if isSignedIn() && isValidId(payrollId) && isValidPayroll(incoming()) && isAdmin();
      allow delete: if isAdmin();
    }

  }
}
